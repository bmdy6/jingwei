<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xlagent.qq</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/user/bot-我的自搭建agent/肖亮搭建的agent/启动QQAgent.command</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/path/to/user/.xlagent/qq_agent.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/user/.xlagent/qq_agent.err</string>
    <key>WorkingDirectory</key>
    <string>/path/to/user/bot-我的自搭建agent/肖亮搭建的agent</string>
</dict>
</plist>
