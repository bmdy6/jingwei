# 复制为 .env；在本地填写凭据。不要提交 .env。
# 优先级：进程环境变量 > .env > config/settings.yaml。
MYAGENT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
MYAGENT_API_KEY=
MYAGENT_API_BASE=https://api.deepseek.com/v1
MYAGENT_MAX_TURNS=30
# 可选独立的快/慢模型；留空时继承 MYAGENT_MODEL。
MYAGENT_MODEL_FLASH=
MYAGENT_MODEL_PRO=

# 本地向量模型需事先放入 config/settings.yaml 的 memory.local_model_path。
# 缺少模型时使用关键词检索，不会自动下载模型。
EMBEDDING_MODE=local
# 云端向量模式按需设置（会产生额外 API 请求）。
# MYAGENT_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=

# 所有路径均可按需重定向；默认不读取任何个人笔记目录。
# MYAGENT_MEMORY_DIR=~/.xl-agent/memory
# MYAGENT_SESSION_DIR=~/.xl-agent/sessions
# MYAGENT_AGENT_MEMORY_DIR=./agent_memory
# MYAGENT_QUEUE_DIR=~/.xl-agent/tasks
# MYAGENT_SCRATCH_DIR=~/.xl-agent/scratch
# MYAGENT_NOTES_DIR=~/.xl-agent/notes
# MYAGENT_KB_DIR=~/.xl-agent/notes

# QQ 仅在显式启用并配置管理员后启动；默认不注册 QQ 发信/状态/图片工具。
QQ_ENABLED=false
QQ_ADMIN_ID=
QQ_BOT_ID=
MY_AGENT_WHITE_LIST=
QQ_WHITE_GROUPS=
QQ_COWORKER_IDS=
QQ_OTHER_BOT_IDS=
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_HTTP_URL=http://127.0.0.1:3020
NAPCAT_TOKEN=
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
QQ_CSMA_BACKOFF_SECONDS=2.0
QQ_FATIGUE_SLEEP_MINUTES=15.0
QQ_FATIGUE_RATE=0.4
SESSION_PERMISSION_TIMEOUT=1800

# 可选 MCP / 媒体集成：默认留空，需自行安装并认证。
STITCH_SERVER_CMD=
STITCH_API_KEY=
STITCH_TIMEOUT=180
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
# STITCH_GCLOUD_BIN=gcloud
# STITCH_CLOUDSDK_CONFIG=~/.stitch-mcp/config
# STITCH_OUTPUT_DIR=~/.xl-agent/stitch_outputs
NOTEBOOKLM_BIN=notebooklm-mcp
# NOTEBOOKLM_AUTH_FILE=~/.notebooklm-mcp/auth.json
IMAGE2_BASE=
IMAGE2_USER=
IMAGE2_PASS=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_COS_BUCKET=
TENCENT_CLOUD_COS_REGION=ap-guangzhou
